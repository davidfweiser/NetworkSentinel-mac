<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:NetworkSentinel.Controls"
        xmlns:vm="using:NetworkSentinel.ViewModels"
        x:Class="NetworkSentinel.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icon.png"
        Width="1320" Height="860"
        MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeepBrush}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <!-- UI scale. Every font size in this file is an absolute device-independent
       pixel. macOS already draws those against the display's backing scale, so
       the default here is 1.0 — unlike the Linux build, which ships 1.75 because
       an X11 session on an unscaled 4K panel does not. The knob is still worth
       having: it is the one way to make the whole window bigger, and scaling
       here beats raising the 194 FontSize literals, because the column widths,
       paddings and the icon well are fixed too — text alone would grow into a
       clipped layout rather than a bigger one.

       LayoutTransformControl scales during layout, not just at paint, so children
       measure against the scaled size and wrapping, trimming and scrolling all stay
       correct. The multiplier is Settings -> Display -> Text size, persisted as
       UiScale and applied by the code-behind, which is where the transform is set:
       a ScaleTransform is not a StyledElement, so it inherits no DataContext and
       cannot carry a binding of its own. -->
  <LayoutTransformControl x:Name="UiScaler">

  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" MinWidth="200" MaxWidth="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Classes="card" Margin="0,0,14,0" Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="4,4,4,18">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" ClipToBounds="True">
              <Image Source="/Assets/icon.png" Width="42" Height="42" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <!-- Wraps rather than clipping: the rail is 230px and the mark takes
                   54 of them, which leaves the title a few pixels short of fitting
                   on one line — it read as "Network Sentine". -->
              <TextBlock Text="Network Sentinel" FontSize="16" FontWeight="Bold"
                         TextWrapping="Wrap"/>
              <TextBlock Text="Port &amp; intrusion watch" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
              <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" Opacity="0.85"/>
              <TextBlock Text="macOS" Foreground="{DynamicResource AccentCyanBrush}" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Border Background="#0DFFFFFF" CornerRadius="14" Padding="12"
                  BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Text="{Binding Stats.StatusText}" TextWrapping="Wrap" Margin="0,6,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding Stats.IsMonitoring, Converter={StaticResource BoolToVis}, ConverterParameter=Invert, FallbackValue=#636B78}"/>
                <TextBlock Text="{Binding Stats.IsMonitoring, Converter={StaticResource MonitorText}}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="10"
                      BorderThickness="1" BorderBrush="{DynamicResource StrokeSoftBrush}" Background="#0DFFFFFF">
                <StackPanel>
                  <TextBlock Text="AUTO-BLOCK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                  <CheckBox Content="Enable auto-block" IsChecked="{Binding AutoBlockEnabled}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,8"/>
          <RadioButton Classes="nav" Content="Dashboard" GroupName="Nav"
                       IsChecked="{Binding ShowDashboard, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
          <RadioButton Classes="nav" Content="Live Connections" GroupName="Nav"
                       IsChecked="{Binding ShowConnections, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="Connections"/>
          <RadioButton Classes="nav" Content="Remote Computers" GroupName="Nav"
                       IsChecked="{Binding ShowHosts, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="Hosts"/>
          <RadioButton Classes="nav" Content="Break-in Attempts" GroupName="Nav"
                       IsChecked="{Binding ShowThreats, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="Threats"/>
          <RadioButton Classes="nav" Content="Open Ports" GroupName="Nav"
                       IsChecked="{Binding ShowPorts, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="Ports"/>
          <RadioButton Classes="nav" Content="Firewall &amp; Block" GroupName="Nav"
                       IsChecked="{Binding ShowFirewall, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="Firewall"/>
          <RadioButton Classes="nav sub" Content="Firewall Config" GroupName="Nav"
                       IsChecked="{Binding ShowFirewallConfig, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="FirewallConfig"
                       ToolTip.Tip="Add, edit and delete inbound and outbound rules"/>
          <RadioButton Classes="nav" Content="Blocked Sites" GroupName="Nav"
                       IsVisible="{Binding DnsFilterConfigured}"
                       IsChecked="{Binding ShowDnsBlocked, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="DnsBlocked"
                       ToolTip.Tip="Names the filtering resolver refused"/>
          <RadioButton Classes="nav" Content="Settings" GroupName="Nav"
                       IsChecked="{Binding ShowSettings, Mode=OneWay}"
                       Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <StackPanel Margin="0,0,0,14">
        <TextBlock Text="{Binding ClockText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
        <TextBlock Text="Network Defense Console" FontSize="22" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding HeroSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12"/>
        <WrapPanel>
          <TextBox Classes="modern" Width="180" Watermark="Filter…"
                   Text="{Binding SearchText}" Margin="0,0,8,8"/>
          <Button Classes="primary" Content="{Binding Stats.IsMonitoring, Converter={StaticResource MonitorText}}"
                  Command="{Binding ToggleMonitoringCommand}" Margin="0,0,8,8" MinWidth="110"/>
          <Button Classes="ghost" Content="Auto-block toggle" Command="{Binding ToggleAutoBlockCommand}"
                  Margin="0,0,8,8" MinWidth="110" ToolTip.Tip="{Binding AutoBlockStatusText}"/>
          <Button Classes="ghost" Content="Authorize firewall" Command="{Binding RunAsAdminCommand}"
                  ToolTip.Tip="{Binding FirewallStatusText}" Margin="0,0,8,8"/>
          <Button Classes="ghost" Content="Clear Alerts" Command="{Binding ClearThreatsCommand}" Margin="0,0,8,8"/>
          <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshNowCommand}" Margin="0,0,8,8"/>
        </WrapPanel>
      </StackPanel>

      <Grid Grid.Row="1">
        <!-- DASHBOARD -->
        <!-- Scrolled: the stat row, two chart rows and the two lists together are
             taller than the window at its minimum height. -->
        <!-- BringIntoViewOnFocusChange off: the signal and host lists inside ask to
             scroll their first row into view as items arrive, which dragged the whole
             dashboard down past the stat tiles the moment the first alert landed. -->
        <ScrollViewer IsVisible="{Binding ShowDashboard}" HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.BringIntoViewOnFocusChange="False">
        <!-- 250, not 220: the chart cards carry a legend row under the plot. -->
        <Grid RowDefinitions="Auto,250,230,Auto,Auto" Margin="0,0,6,0">
          <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,14">
            <Border Classes="stat" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="LISTENING PORTS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Stats.ListeningPorts}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                           Foreground="{DynamicResource SuccessBrush}"/>
                <TextBlock Text="TCP + UDP open" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
              </StackPanel>
            </Border>
            <Border Classes="stat" Grid.Column="1" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="ACTIVE SESSIONS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Stats.ActiveConnections}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                           Foreground="{DynamicResource AccentBlueBrush}"/>
                <TextBlock Text="TCP connections" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
              </StackPanel>
            </Border>
            <Border Classes="stat" Grid.Column="2" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="REMOTE COMPUTERS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Stats.RemoteHosts}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                           Foreground="{DynamicResource AccentCyanBrush}"/>
                <TextBlock Text="Peers tracked" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
              </StackPanel>
            </Border>
            <Border Classes="stat" Grid.Column="3" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="THREAT EVENTS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Stats.ThreatsToday}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                           Foreground="{DynamicResource AccentAmberBrush}"/>
                <TextBlock Text="Heuristic alerts" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
              </StackPanel>
            </Border>
            <Border Classes="stat" Grid.Column="4">
              <StackPanel>
                <TextBlock Text="HIGH / CRITICAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Stats.HighThreats}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                           Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock Text="Needs attention" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="0,0,0,14">
            <Border Classes="card" Margin="0,0,10,0">
              <Grid RowDefinitions="Auto,*,Auto">
                <DockPanel>
                  <TextBlock Text="Connection activity" FontWeight="Bold" FontSize="14"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ActivityWindowText}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <ctrl:Sparkline Grid.Row="1" Margin="0,12,0,0"
                                Values="{Binding ActivitySeries}"
                                Threats="{Binding ThreatSeries}"
                                Stroke="{DynamicResource AccentCyanBrush}"
                                Fill="{DynamicResource ChartFill}"
                                StrokeThickness="2.4"/>

                <!-- Legend row, matching the web chart: time range at the edges,
                     current/peak connections and the window's alert count between. -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                  <TextBlock Text="{Binding ActivityFromText}" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="●" FontSize="11" Margin="0,0,4,0"
                               Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActivityConnectionsText}" FontSize="10" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="▮" FontSize="11" Margin="0,0,4,0"
                               Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActivityThreatText}" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </WrapPanel>
                  <TextBlock Grid.Column="2" Text="{Binding ActivityToText}" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Border>
            <Border Classes="card" Grid.Column="1" Background="{DynamicResource HeroGradient}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="2" Background="#263BC8B4">
                  <TextBlock Text="LIVE" FontWeight="Bold" FontSize="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource AccentCyanBrush}"/>
                </Border>
                <TextBlock Text="Threat intensity" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Stats.HighThreats}" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock Text="high-severity signals" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- DATA FLOW — live throughput beside the running month's totals. -->
          <Grid Grid.Row="2" ColumnDefinitions="2*,*" Margin="0,0,0,14">
            <Border Classes="card" Margin="0,0,10,0">
              <Grid RowDefinitions="Auto,*,Auto">
                <DockPanel>
                  <TextBlock Text="Data flow" FontWeight="Bold" FontSize="14"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding TrafficWindowText}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <ctrl:DualSparkline Grid.Row="1" Margin="0,12,0,0"
                                    Inbound="{Binding TrafficInSeries}"
                                    Outbound="{Binding TrafficOutSeries}"
                                    InboundStroke="{DynamicResource AccentBlueBrush}"
                                    OutboundStroke="{DynamicResource AccentCyanBrush}"
                                    InboundFill="{DynamicResource ChartFill}"
                                    StrokeThickness="2.2"/>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="●" FontSize="11" Margin="0,0,4,0"
                               Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TrafficInRateText}" FontSize="10" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="●" FontSize="11" Margin="0,0,4,0"
                               Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TrafficOutRateText}" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </WrapPanel>
                  <TextBlock Grid.Column="2" Text="{Binding TrafficStatusText}" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                </Grid>
              </Grid>
            </Border>

            <Border Classes="card" Grid.Column="1">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="THIS MONTH" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding MonthLabelText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Data in" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding MonthInText}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlueBrush}"/>
                <TextBlock Text="Data out" FontSize="10" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding MonthOutText}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AccentCyanBrush}"/>
                <TextBlock Text="{Binding MonthTotalText, StringFormat='{}{0} total'}" FontSize="11"
                           Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding MonthDailyAverageText}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- MONTHLY DATA — one bar pair per day of the month, or per month of
               the year. Bars, not a line: these are totals over discrete periods. -->
          <Border Classes="card" Grid.Row="3" Height="250" Margin="0,0,0,14">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Monthly data in and out" FontWeight="Bold" FontSize="14"/>
                  <TextBlock Text="{Binding TrafficRangeSummary}" FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="180" VerticalAlignment="Top"
                          ItemsSource="{Binding TrafficRangeOptions}"
                          SelectedItem="{Binding SelectedTrafficRange}"/>
              </Grid>
              <ctrl:BarPairChart Grid.Row="1" Margin="0,12,0,0"
                                 Buckets="{Binding TrafficBuckets}"
                                 InboundBrush="{DynamicResource AccentBlueBrush}"
                                 OutboundBrush="{DynamicResource AccentCyanBrush}"/>
              <WrapPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Center">
                <TextBlock Text="▮" FontSize="11" Margin="0,0,4,0"
                           Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="data in" FontSize="10" Margin="0,0,14,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="▮" FontSize="11" Margin="0,0,4,0"
                           Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="data out" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </WrapPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="4" ColumnDefinitions="*,*" Height="320">
            <Border Classes="card" Margin="0,0,10,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Latest break-in signals" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding Threats}" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#0DFFFFFF" CornerRadius="12" Padding="12" Margin="0,0,0,8"
                              BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="6,*">
                          <Border CornerRadius="3" Background="{Binding Level, Converter={StaticResource ThreatBrush}}"/>
                          <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SourceIp}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding Origin}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Method}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Classes="card" Grid.Column="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Connected / observed computers" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding RemoteHosts}" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#0DFFFFFF" CornerRadius="12" Padding="12" Margin="0,0,0,8"
                              BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding GeoSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding Status}"/>
                          </StackPanel>
                          <Border Grid.Column="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Top" Background="#22000000">
                            <TextBlock Text="{Binding ThreatText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding ThreatLevel, Converter={StaticResource ThreatBrush}}"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
        </ScrollViewer>

        <!-- CONNECTIONS -->
        <Border Classes="card" IsVisible="{Binding ShowConnections}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Live TCP connections" FontWeight="Bold" FontSize="15"/>
              <TextBlock Text="Select a row and use Block to create a host firewall rule for that remote IP."
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}"
                      AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="110"/>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                <DataGridTextColumn Header="Local" Binding="{Binding DisplayLocal}" Width="140"/>
                <DataGridTextColumn Header="Remote" Binding="{Binding DisplayRemote}" Width="*"/>
                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90"/>
                <DataGridTextColumn Header="Origin" Binding="{Binding GeoSummary}" Width="170"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                <DataGridTemplateColumn Header="Action" Width="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Classes="mini-danger" Content="Block IP"
                              Command="{Binding $parent[Window].DataContext.BlockConnectionIpCommand}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- HOSTS -->
        <Border Classes="card" IsVisible="{Binding ShowHosts}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Remote computers connected or probing this PC" FontWeight="Bold" FontSize="15"/>
              <TextBlock Text="Block writes host firewall rules for that IP. Private/LAN addresses are refused for safety."
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding RemoteHosts}" SelectedItem="{Binding SelectedHost}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="120"/>
                <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="140"/>
                <DataGridTextColumn Header="Where (origin)" Binding="{Binding GeoSummary}" Width="*"/>
                <DataGridTextColumn Header="Threat" Binding="{Binding ThreatText}" Width="80"/>
                <DataGridTextColumn Header="Firewall" Binding="{Binding BlockStatusText}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Active" Binding="{Binding ActiveConnections}" Width="60"/>
                <DataGridTextColumn Header="Ports" Binding="{Binding PortsTouched}" Width="60"/>
                <DataGridTemplateColumn Header="Actions" Width="160">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="mini-danger" Content="Block"
                                Command="{Binding $parent[Window].DataContext.BlockHostCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding IsBlocked, Converter={StaticResource InvertBool}}"/>
                        <Button Classes="mini-ghost" Content="Unblock"
                                Command="{Binding $parent[Window].DataContext.UnblockHostCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding IsBlocked}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- THREATS -->
        <Border Classes="card" IsVisible="{Binding ShowThreats}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Break-in / intrusion attempt signals" FontWeight="Bold" FontSize="15"/>
              <TextBlock Text="Heuristics detect port scans, SSH/SMB hammering, sensitive-port probes, and short-lived bursts."
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Threats}" SelectedItem="{Binding SelectedThreat}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="70"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding LevelText}" Width="80"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="130"/>
                <DataGridTextColumn Header="Source IP" Binding="{Binding SourceIp}" Width="120"/>
                <DataGridTextColumn Header="Coming from" Binding="{Binding Origin}" Width="160"/>
                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="150"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                <DataGridTemplateColumn Header="Action" Width="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Classes="mini-danger" Content="Block IP"
                              Command="{Binding $parent[Window].DataContext.BlockThreatIpCommand}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- BLOCKED SITES -->
        <Border Classes="card" IsVisible="{Binding ShowDnsBlocked}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Names your filtering resolver refused" FontWeight="Bold" FontSize="15"/>
              <TextBlock Text="Newest first, read from the resolver's own query log when you open this page. This is a name-based block: a client that dials a hard-coded address never asks, so it never appears here — that half is what the threat-intel feeds and the prevention engine cover."
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                         Margin="0,4,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Refresh" Command="{Binding RefreshBlockedSitesCommand}"/>
                <TextBlock Text="{Binding BlockedSitesStatus}" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"/>
              </StackPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding BlockedSites}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Domain}" Width="280"/>
                <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="140"/>
                <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="140"/>
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- PORTS -->
        <Border Classes="card" IsVisible="{Binding ShowPorts}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Open / listening ports on this computer" FontWeight="Bold" FontSize="15"/>
              <TextBlock Text="Block Port creates an inbound host firewall rule for that local port (use carefully)."
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding ListeningPorts}" SelectedItem="{Binding SelectedPort}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding DisplayEndpoint}" Width="200"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceHint}" Width="140"/>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="140"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                <DataGridTemplateColumn Header="Action" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Classes="mini-danger" Content="Block Port"
                              Command="{Binding $parent[Window].DataContext.BlockSelectedPortCommand}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- FIREWALL -->
        <Grid IsVisible="{Binding ShowFirewall}" RowDefinitions="Auto,*">
          <StackPanel Margin="0,0,0,12" Spacing="12">
            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Auto-block" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="{Binding AutoBlockStatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" Margin="0,6,0,10" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Turn auto-block on" IsChecked="{Binding AutoBlockEnabled}" VerticalAlignment="Center"/>
                    <TextBlock Text="Minimum severity" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <ComboBox Width="120" ItemsSource="{Binding AutoBlockLevelOptions}"
                              SelectedItem="{Binding AutoBlockMinLevel}" IsEnabled="{Binding AutoBlockEnabled}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                  <Button Classes="primary" Content="Toggle Auto-block" Command="{Binding ToggleAutoBlockCommand}" MinWidth="150"/>
                  <Button Classes="ghost" Content="Restore good sites" Command="{Binding RestoreAllowlistedCommand}" MinWidth="150"/>
                  <Button Classes="ghost" Content="Authorize firewall" Command="{Binding RunAsAdminCommand}" MinWidth="150"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBlock Text="Known-good allowlist (never block)" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="{Binding AllowlistStatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBox Classes="modern" Text="{Binding AllowlistInput}" Watermark="Domain or IP"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" Spacing="6">
                      <Button Classes="primary" Content="Add" Command="{Binding AddAllowlistEntryCommand}" MinWidth="70"/>
                      <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshAllowlistCommand}"/>
                      <Button Classes="ghost" Content="Remove" Command="{Binding RemoveAllowlistEntryCommand}"/>
                      <Button Classes="ghost" Content="Open folder" Command="{Binding OpenAllowlistFolderCommand}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <DataGrid ItemsSource="{Binding AllowlistEntries}" SelectedItem="{Binding SelectedAllowlistEntry}"
                          AutoGenerateColumns="False" MaxHeight="160">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="220"/>
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" Margin="0">
              <Border Classes="card" Margin="0,0,10,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="Block remote IP" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="{Binding FirewallStatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" TextWrapping="Wrap"/>
                  <TextBox Classes="modern" Text="{Binding ManualBlockIp}" Watermark="e.g. 203.0.113.50"/>
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Inbound" IsChecked="{Binding BlockInbound}"/>
                    <CheckBox Content="Outbound" IsChecked="{Binding BlockOutbound}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="danger" Content="Block IP" Command="{Binding BlockManualIpCommand}" MinWidth="110"/>
                    <Button Classes="ghost" Content="Unblock IP" Command="{Binding UnblockManualIpCommand}" MinWidth="110"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="card" Grid.Column="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Block local port" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Creates a host firewall drop rule for a local TCP/UDP port."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,120">
                    <TextBox Classes="modern" Text="{Binding ManualBlockPort}" Watermark="e.g. 22" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProtocolOptions}"
                              SelectedItem="{Binding ManualBlockProtocol}"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="danger" Content="Block Port" Command="{Binding BlockManualPortCommand}" MinWidth="110"/>
                    <Button Classes="ghost" Content="Refresh Rules" Command="{Binding RefreshFirewallRulesCommand}"/>
                    <Button Classes="ghost" Content="Remove All" Command="{Binding RemoveAllManagedRulesCommand}" MinWidth="110"/>
                  </StackPanel>
                  <TextBlock Text="{Binding FirewallMessage}" TextWrapping="Wrap"
                             Foreground="{DynamicResource AccentCyanBrush}" FontSize="12"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <Border Classes="card" Grid.Row="1">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Network Sentinel firewall rules" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Only rules created by this app (name prefix NetworkSentinel-*) are listed."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Classes="danger" DockPanel.Dock="Right" Content="Remove Selected"
                        Command="{Binding RemoveSelectedRuleCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </DockPanel>
              <DataGrid ItemsSource="{Binding FirewallRules}" SelectedItem="{Binding SelectedFirewallRule}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="90"/>
                  <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="70"/>
                  <DataGridTextColumn Header="Direction" Binding="{Binding DirectionText}" Width="90"/>
                  <DataGridTextColumn Header="Target" Binding="{Binding TargetText}" Width="160"/>
                  <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                  <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledText}" Width="70"/>
                  <DataGridTextColumn Header="Rule name" Binding="{Binding Name}" Width="*"/>
                  <DataGridTemplateColumn Header="" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Classes="mini-ghost" Content="Remove"
                                Command="{Binding $parent[Window].DataContext.RemoveSelectedRuleCommand}"
                                CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>

        <!-- FIREWALL CONFIG — add/edit/delete inbound and outbound rules, laid out
             like the Linode Cloud Manager firewall page (and FireWallConfig on
             Ubuntu): one list per direction, one form for both add and edit. -->
        <ScrollViewer IsVisible="{Binding ShowFirewallConfig}" HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.BringIntoViewOnFocusChange="False">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,6,0">
          <Border Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Firewall configuration" FontWeight="Bold" FontSize="15"/>
                <TextBlock Text="{Binding FirewallConfigSummary}" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FirewallConfigListenerText}" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FirewallConfigPolicyText}" Margin="0,6,16,0" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FirewallConfigMessage}" Margin="0,6,0,0" FontSize="12"
                           Foreground="{DynamicResource AccentAmberBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="8" Margin="16,0,0,0">
                <Button Classes="primary" Content="Add an Inbound Rule" MinWidth="180"
                        Command="{Binding AddInboundRuleCommand}"/>
                <Button Classes="ghost" Content="Add an Outbound Rule" MinWidth="180"
                        Command="{Binding AddOutboundRuleCommand}"/>
                <Button Classes="ghost" Content="Rescan the host firewall" MinWidth="180"
                        Command="{Binding RefreshFirewallConfigCommand}"
                        ToolTip.Tip="Re-reads the PF ruleset, the Application Firewall and the listening sockets"/>
                <TextBlock Text="Scanning…" FontSize="11" HorizontalAlignment="Right"
                           IsVisible="{Binding IsFirewallConfigScanning}"
                           Foreground="{DynamicResource AccentCyanBrush}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Add/edit form. Inline rather than a modal: the rule lists stay
               visible while a rule is written, which is how you check you are not
               duplicating one. -->
          <Border x:Name="RuleEditorCard" Classes="card" Grid.Row="1" Margin="0,0,0,12"
                  IsVisible="{Binding IsRuleEditorOpen}">
            <StackPanel Spacing="10">
              <StackPanel>
                <TextBlock Text="{Binding RuleEditorTitle}" FontWeight="Bold" FontSize="15"/>
                <TextBlock Text="{Binding RuleEditorNote}" FontSize="11.5" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="Preset" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RulePresetOptions}"
                            SelectedItem="{Binding RulePreset}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="Action" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RuleActionOptions}"
                            SelectedItem="{Binding RuleAction}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Direction" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RuleDirectionOptions}"
                            SelectedItem="{Binding RuleDirection}"/>
                </StackPanel>
              </Grid>

              <StackPanel>
                <TextBlock Text="Label" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Classes="modern" Text="{Binding RuleLabel}"
                         Watermark="block-inbound-ssh   (optional — named from the port if left empty)"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,2*">
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="Protocol" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RuleProtocolOptions}"
                            SelectedItem="{Binding RuleProtocol}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Port range" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <TextBox Classes="modern" Text="{Binding RulePortRange}"
                           Watermark="22   or  8000-8001   or  80, 443   (empty = every port)"/>
                </StackPanel>
              </Grid>

              <StackPanel>
                <TextBlock Text="{Binding RuleAddressLabel}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Classes="modern" Text="{Binding RuleAddresses}"
                         Watermark="All IPv4, All IPv6   or  10.0.0.0/8   or  203.0.113.5"/>
              </StackPanel>

              <TextBlock Text="{Binding RuleEditorError}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerBrush}"/>

              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="Cancel" MinWidth="110"
                        Command="{Binding CancelRuleEditorCommand}"/>
                <Button Classes="primary" Content="{Binding RuleEditorSaveText}" MinWidth="130"
                        Command="{Binding SaveConfigRuleCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- MinHeight, not a fixed height: the lists share whatever the window
               leaves them, but never shrink to a single row when the editor is open. -->
          <Grid Grid.Row="2" RowDefinitions="*,*,Auto">
            <Border Classes="card" Margin="0,0,0,12" MinHeight="230">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Inbound rules" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="{Binding InboundCountText}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Add an Inbound Rule"
                          VerticalAlignment="Center" Command="{Binding AddInboundRuleCommand}"/>
                </Grid>
                <DataGrid ItemsSource="{Binding InboundRules}" SelectedItem="{Binding SelectedInboundRule}"
                          AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <!-- Label and the address list share the slack: a rule name and an
                         IPv6 range are both long, and fixing either at 190px cut them in
                         half. The wide class gives those cells the ellipsis-and-tooltip
                         treatment, so a value too wide for its column is still readable. -->
                    <DataGridTextColumn Header="Label" Binding="{Binding LabelText}" Width="*" MinWidth="220"
                                        CellStyleClasses="wide"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="95"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolText}" Width="105"/>
                    <DataGridTextColumn Header="Port range" Binding="{Binding PortRangeText}" Width="125"/>
                    <DataGridTextColumn Header="Sources" Binding="{Binding AddressListText}" Width="*" MinWidth="200"
                                        CellStyleClasses="wide"/>
                    <DataGridTextColumn Header="Created by" Binding="{Binding OriginText}" Width="150"
                                        CellStyleClasses="wide"/>
                    <!-- Auto, not a pinned width: Edit and Delete are shown together here
                         (unlike the Block/Unblock pairs elsewhere, which swap), and the two
                         buttons plus their 4px gap do not fit the 150px this column was
                         pinned at — Delete lost its rounded edge. Sizing to the content
                         cannot drift out again when a label or a button style changes. -->
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="164">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="mini-ghost" Content="Edit"
                                    Command="{Binding $parent[Window].DataContext.EditConfigRuleCommand}"
                                    CommandParameter="{Binding}"/>
                            <Button Classes="mini-danger" Content="Delete"
                                    Command="{Binding $parent[Window].DataContext.DeleteConfigRuleCommand}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <Border Classes="card" Grid.Row="1" MinHeight="230" Margin="0,0,0,12">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Outbound rules" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="{Binding OutboundCountText}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Add an Outbound Rule"
                          VerticalAlignment="Center" Command="{Binding AddOutboundRuleCommand}"/>
                </Grid>
                <DataGrid ItemsSource="{Binding OutboundRules}" SelectedItem="{Binding SelectedOutboundRule}"
                          AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <!-- Label and the address list share the slack: a rule name and an
                         IPv6 range are both long, and fixing either at 190px cut them in
                         half. The wide class gives those cells the ellipsis-and-tooltip
                         treatment, so a value too wide for its column is still readable. -->
                    <DataGridTextColumn Header="Label" Binding="{Binding LabelText}" Width="*" MinWidth="220"
                                        CellStyleClasses="wide"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="95"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolText}" Width="105"/>
                    <DataGridTextColumn Header="Port range" Binding="{Binding PortRangeText}" Width="125"/>
                    <DataGridTextColumn Header="Destinations" Binding="{Binding AddressListText}" Width="*" MinWidth="200"
                                        CellStyleClasses="wide"/>
                    <DataGridTextColumn Header="Created by" Binding="{Binding OriginText}" Width="150"
                                        CellStyleClasses="wide"/>
                    <!-- Auto, not a pinned width: Edit and Delete are shown together here
                         (unlike the Block/Unblock pairs elsewhere, which swap), and the two
                         buttons plus their 4px gap do not fit the 150px this column was
                         pinned at — Delete lost its rounded edge. Sizing to the content
                         cannot drift out again when a label or a button style changes. -->
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="164">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="mini-ghost" Content="Edit"
                                    Command="{Binding $parent[Window].DataContext.EditConfigRuleCommand}"
                                    CommandParameter="{Binding}"/>
                            <Button Classes="mini-danger" Content="Delete"
                                    Command="{Binding $parent[Window].DataContext.DeleteConfigRuleCommand}"
                                    CommandParameter="{Binding}"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <!-- What is listening, and what the rules above do to it. A rule list on
                 its own does not answer "is this port actually reachable" — the two
                 together do, which is the pairing FireWallConfig shows. -->
            <Border Classes="card" Grid.Row="2" MinHeight="200">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBlock Text="Listening services" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="{Binding FirewallConfigListenerText}" FontSize="11.5" Margin="0,2,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="{Binding FirewallConfigListenerHint}" FontSize="11.5" Margin="0,2,0,0"
                             Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding ListeningServices}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="*" MinWidth="160"
                                        CellStyleClasses="wide"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="105"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80"/>
                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="150"
                                        CellStyleClasses="wide"/>
                    <DataGridTextColumn Header="Bind address" Binding="{Binding Address}" Width="*" MinWidth="170"
                                        CellStyleClasses="wide"/>
                    <DataGridTextColumn Header="Firewall" Binding="{Binding Covered}" Width="120"/>
                    <DataGridTemplateColumn Header="" Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Classes="mini-ghost" Content="New rule"
                                  Command="{Binding $parent[Window].DataContext.NewRuleForListenerCommand}"
                                  CommandParameter="{Binding}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
        </ScrollViewer>

        <!-- SETTINGS — mirrors the web console's Settings tab so both front-ends
             drive the same keys in settings.json. Auto-block lives in the sidebar
             and the Firewall view, so it is not duplicated here. -->
        <Grid IsVisible="{Binding ShowSettings}" RowDefinitions="*,Auto">
          <ScrollViewer>
            <StackPanel Spacing="14">
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Display" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="How this window is drawn on this screen."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,14" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Text size" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Scales the whole window — text, tables, charts and spacing together — so nothing is left clipped by text that outgrew it. macOS already sizes the window for the display it is on, so 100% is right on most Macs; the larger steps are for reading it from further away, or on a screen driven at a resolution that leaves the labels small. Applies straight away."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="205" VerticalAlignment="Center"
                              ItemsSource="{Binding UiScaleOptions}"
                              SelectedItem="{Binding SelectedUiScale}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Monitoring" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="What the monitor watches, and how often it samples."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,14" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Live monitoring" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Watch connections, listening ports, and threats in real time."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" MinWidth="110"
                            Content="{Binding Stats.IsMonitoring, Converter={StaticResource MonitorText}}"
                            Command="{Binding ToggleMonitoringCommand}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Monitor poll interval" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="How often the monitor samples the network stack. This is also the activity chart's sample rate, so a slower interval widens the window the chart covers."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="205" VerticalAlignment="Center"
                              ItemsSource="{Binding MonitorPollOptions}"
                              SelectedItem="{Binding SelectedMonitorPoll}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Geo lookups" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Resolve country and city for remote IPs (ipwho.is, ipapi.co fallback — both over HTTPS). Reverse DNS still runs when this is off."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding GeoLookupEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Traffic metering" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Sample the interface byte counters (netstat) for the dashboard's data-flow charts and the monthly in/out history. Physical interfaces only, so VPN traffic is counted once."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding TrafficStatusText}" FontSize="11" Margin="0,4,0,0"
                                 Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding TrafficMeterEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Auth-log monitoring" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Watch the macOS unified log (sshd, sudo, login, Screen Sharing) for failed logons and alert on brute-force bursts."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding AuthLogStatusText}" FontSize="11" Margin="0,4,0,0"
                                 Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding AuthLogMonitorEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Closed-port scan detection" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Install a PF SYN-log rule and decode pflog0 (asks for your Mac password) — catches scans of closed ports that never appear as connections."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding ProbeLogStatusText}" FontSize="11" Margin="0,4,0,0"
                                 Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding ProbeLogEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Critical threat alerts" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Send a macOS notification when a Critical-level threat is detected, so you are warned even while this window is minimized or behind other apps."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding CriticalAlertStatusText}" FontSize="11" Margin="0,4,0,0"
                                 Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding CriticalAlertsEnabled}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Intrusion detection" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Extra detectors beyond the connection heuristics."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,14" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Threat-intel blocklists" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Check remote IPs against FireHOL level1 and Spamhaus DROP. A match is an instant Critical alert — those ranges are attack infrastructure."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding ThreatIntelEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="New-listener alerts" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Alert when a new port starts listening after the baseline, or a known port changes owner process — the backdoor / implant signature."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding NewListenerAlertsEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Process reputation" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Flag unsigned or quarantined binaries talking to public hosts, executables running from temp/download folders, and shell processes with outbound connections (reverse-shell signature)."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding ProcessReputationEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="ARP / gateway watch" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Watch the ARP table for the default gateway's MAC address changing — the standard LAN man-in-the-middle opener."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding ArpWatchEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Launch-item watch" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Watch LaunchAgents and LaunchDaemons folders for new or modified startup items — the standard way malware persists across reboots."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding LaunchItemWatchEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Exfiltration monitor" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Sample per-connection byte counts (nettop) and alert when outbound traffic to one non-allowlisted public host exceeds the threshold (MB per 10 minutes)."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="70" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="{Binding ExfilThresholdMbText}" Watermark="250"/>
                    <CheckBox Grid.Column="2" VerticalAlignment="Center"
                              IsChecked="{Binding ExfilMonitorEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Honeypot decoy ports" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Listen on decoy TCP ports nothing legitimate uses. Any completed connection is a zero-false-positive Critical alert. Ports already in use are skipped."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="130" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="{Binding HoneypotPortsText}" Watermark="2323,3389,5900"/>
                    <CheckBox Grid.Column="2" VerticalAlignment="Center"
                              IsChecked="{Binding HoneypotEnabled}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="DNS filtering" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="The only control here that stops a connection before it is attempted. Everything else acts on a flow that already exists — and a VPN client's forwarded traffic never becomes a tracked connection at all, so nothing else on this page can block where a client goes. Point this at the AdGuard Home serving your tunnel; the Linux build's scripts/setup-dns-filter.sh is what installs one."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,10" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding DnsFilterStatus}" FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Margin="0,0,0,14" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Filter names at the resolver" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Refuse known malware, phishing and tracking names before anything connects. This switches filtering, not the resolver: turning it off leaves DNS answering normally but unfiltered, so no client loses name resolution."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding DnsFilterEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Filtering resolver" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Admin API of the filtering resolver — its tunnel address, from this Mac. Clear it to leave the switch unconfigured."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                             Text="{Binding DnsFilterUrl}" Watermark="http://10.8.0.1:3000"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Resolver user" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Admin user for that API — &quot;admin&quot; for an AdGuard Home the setup script installed. Leave empty if the resolver needs no login."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                             Text="{Binding DnsFilterUsername}" Watermark="admin"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Resolver password" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Password for that user. Stored owner-only in settings.json. Without it the switch cannot authenticate and reports that the resolver rejected the credentials."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                             PasswordChar="●" Text="{Binding DnsFilterPassword}" Watermark="resolver admin password"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Remote access (web console)" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Reach the browser console from outside this Mac over HTTPS. These settings configure the headless web console (--web); this app saves them and keeps the DuckDNS hostname current."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,10" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding RemoteAccessStatus}" FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Margin="0,0,0,14" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="DuckDNS subdomain" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Free hostname that follows your public IP. Enter just the label — &quot;myhost&quot; for myhost.duckdns.org. The switch turns the every-5-minute refresh on."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="180" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="{Binding DuckDnsDomain}" Watermark="myhost"/>
                    <CheckBox Grid.Column="2" VerticalAlignment="Center"
                              IsChecked="{Binding DuckDnsEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="DuckDNS token" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="The token from your duckdns.org account page. Stored owner-only (mode 0600) in its own file, separate from the other settings."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="180" VerticalAlignment="Center" Margin="0,0,12,0"
                             PasswordChar="●" Text="{Binding DuckDnsToken}" Watermark="paste token"/>
                    <Button Grid.Column="2" Content="Update now" VerticalAlignment="Center"
                            Command="{Binding UpdateDuckDnsNowCommand}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Serve the console over HTTPS" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Adds a TLS port alongside the plain-HTTP one. Needs the certificate below. Takes effect the next time the web console starts."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="{Binding HttpsPortText}" Watermark="18443"/>
                    <CheckBox Grid.Column="2" VerticalAlignment="Center"
                              IsChecked="{Binding HttpsEnabled}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Issue certificate" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Get a free trusted Let's Encrypt certificate for your duckdns.org name. Proves control through the DuckDNS token above, so nothing needs to be reachable on port 80. Takes a few minutes waiting on DNS, then fills in the two paths below. Renewals are automatic."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="First run only: installs acme.sh and registers a Let's Encrypt account with the email beside it."
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                 Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="200" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="{Binding AcmeEmail}" Watermark="you@example.com"/>
                    <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" MinWidth="130"
                            Content="{Binding IsIssuingCertificate, Converter={StaticResource IssueCertText}}"
                            Command="{Binding IssueCertificateCommand}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Certificate (PEM fullchain or .pfx)" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Filled in by Issue certificate; edit it if your certificate lives somewhere else."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="280" VerticalAlignment="Center"
                             Text="{Binding TlsCertPath}" Watermark="…/tls/myhost.duckdns.org.fullchain.cer"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Private key (PEM)" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Leave empty when the certificate is a .pfx bundle."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="280" VerticalAlignment="Center"
                             Text="{Binding TlsKeyPath}" Watermark="…/tls/myhost.duckdns.org.key"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Redirect HTTP to HTTPS" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Requests that arrive by hostname get sent to the TLS port. Requests to a bare IP stay on HTTP, because the certificate only covers the name."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding HttpsRedirect}"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="HTTPS only (turn off plain HTTP)" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Skip the plain-HTTP listener entirely, so the master password can only cross the wire encrypted. Needs HTTPS on with a working certificate — if the certificate fails to load at startup, plain HTTP stays on so the console isn't locked out. Takes effect the next time the web console starts."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding HttpsOnly}"/>
                  </Grid>

                  <TextBlock Text="Reaching this from outside your network means anyone who guesses the master password can change this Mac's firewall. A VPN or Tailscale is safer than forwarding a port; if you do forward one, forward only the HTTPS port."
                             Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                             Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Alerting &amp; auto-block" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Get alerts off this machine, and stop block rules from piling up forever."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,14" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Webhook alerts" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="POST Critical threats to a webhook URL — ntfy, Slack, and Discord formats are detected automatically; anything else receives generic JSON. Leave empty to disable."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="280" VerticalAlignment="Center"
                             Text="{Binding WebhookUrl}" Watermark="https://ntfy.sh/your-topic"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Auto-block expiry" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Automatically remove auto-created block rules after this long. Cleanup happens silently when possible (root / cached sudo), otherwise at the next firewall change. Manual blocks are always permanent."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="180" VerticalAlignment="Center"
                              ItemsSource="{Binding AutoBlockExpiryOptions}"
                              SelectedItem="{Binding SelectedAutoBlockExpiry}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Allowlist" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Known-good hosts that are never blocked."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,14" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Remote allowlist feed" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Refresh the known-good domain/IP list from the online feed. Off uses only the local and built-in lists."
                                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                 Margin="0,2,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding AllowlistStatusText}" FontSize="11" Margin="0,4,0,0"
                                 Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding AllowlistUseRemoteFeed}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Data" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Settings, allowlist, and the web console's master-password hash live in your Application Support directory. Both this app and the web console read the same files."
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             Margin="0,4,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding DataDirectoryText}" FontSize="11" Margin="0,8,0,0"
                             Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="1" Classes="card" Margin="0,12,0,0" Padding="12"
                  IsVisible="{Binding SettingsMessage, Converter={StaticResource NotEmpty}}">
            <TextBlock Text="{Binding SettingsMessage}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentCyanBrush}"/>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
  </LayoutTransformControl>
</Window>
