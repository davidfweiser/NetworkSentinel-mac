<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Button.ghost">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="#1AFFFFFF"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Foreground" Value="#FF0A0E14"/>
    <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{DynamicResource DangerGradient}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style Selector="Button.mini-danger">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{DynamicResource DangerGradient}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <Style Selector="Button.mini-ghost">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="#1AFFFFFF"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="18"/>
  </Style>

  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="12"/>
  </Style>

  <Style Selector="TextBox.modern">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="#0DFFFFFF"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,3"/>
  </Style>

  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="#264A9EFF"/>
  </Style>

  <!-- Submenu entry: indented under its parent nav item and a shade quieter,
       so the sidebar reads as a hierarchy rather than a longer flat list. -->
  <Style Selector="RadioButton.nav.sub">
    <Setter Property="Padding" Value="30,9"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#14FFFFFF"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserReorderColumns" Value="False"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
    <Setter Property="CanUserSortColumns" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>

  <!-- Values in these grids are routinely wider than any sensible column: a rule
       label, an address list, an IPv6 range. Trimming says something was cut; it does
       not say what, so a cell marked wide carries its own full text as a tooltip.
       Only the wide columns get one — a tooltip repeating "Block" on every short cell
       is noise, and there is no "is this text actually trimmed" selector to decide it
       per cell. -->
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="DataGridCell.wide TextBlock">
    <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}"/>
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="#0DFFFFFF"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Margin" Value="0,0,14,0"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="MinHeight" Value="36"/>
  </Style>
</Styles>
